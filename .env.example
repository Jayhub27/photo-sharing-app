# Take the shot — environment contract
#
# Server (Vercel / Docker / local). Copy to server/.env for local dev.
# Nothing here is secret in the repo: fill the values in the hosting dashboard.

# Supabase project (service role, server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: storage bucket name, defaults to the project's photo bucket
SUPABASE_STORAGE_BUCKET=

# Public origin used in QR codes, Stripe return URLs and share links.
# Set this in production so a spoofed Host header cannot change them.
PUBLIC_BASE_URL=https://take-the-shot-api.vercel.app

# Extra allowed browser origins for CORS, comma separated
APP_ORIGINS=

# Session lifetime in days (default 30)
SESSION_TTL_DAYS=30

# Stripe (test or live). The webhook secret comes from the endpoint config.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform fee on destination charges, percent (default 0)
STRIPE_APPLICATION_FEE_PERCENT=0

# Error tracking — no-op when empty
SENTRY_DSN=
# Fallback error alert webhook (Discord accepts {"content": "..."}).
# Used only when SENTRY_DSN is empty; one alert per 30 seconds.
ALERT_WEBHOOK_URL=

# Maintenance sweep
MAINTENANCE_SECRET=
MAINTENANCE_SWEEP_INTERVAL_MINUTES=60

# Local only
PORT=3000

# --- Android app (build time, public by design) -------------------------
# Put this in app/.env before `expo start` / an APK build.
EXPO_PUBLIC_API_BASE=https://take-the-shot-api.vercel.app
