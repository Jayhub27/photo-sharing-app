# Take the shot server configuration
# Copy to server/.env and fill in your values. Never commit the real file.

# --- Required: Supabase (cloud or self-hosted) -------------------------------
# Project URL, e.g. https://YOUR-PROJECT.supabase.co
SUPABASE_URL=
# Server-side service role key. Keep this secret: it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket used for originals and thumbnails.
SUPABASE_STORAGE_BUCKET=photos

# --- Basics ------------------------------------------------------------------
PORT=3000
# Public origin used for absolute links (QR codes, Open Graph tags).
# Leave empty on localhost; set to https://your-domain.com in production.
PUBLIC_BASE_URL=
# How long log-in sessions last.
SESSION_TTL_DAYS=30
# Comma separated extra CORS origins, e.g. https://app.example.com
APP_ORIGINS=

# --- Stripe (optional: needed to sell collections) ---------------------------
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Signing secret of the /api/stripe/webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Optional platform fee in percent. Requires Stripe Connect on the owner account.
STRIPE_APPLICATION_FEE_PERCENT=
