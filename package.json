{
  "name": "photo-sharing-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server",
    "server": "npm run dev --workspace server",
    "app": "npm run start --workspace app",
    "website": "npx --yes serve website -l 8080",
    "website:v3": "npx --yes serve website-v3 -l 8080",
    "build": "npm run build --workspace server",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs"
  },
  "overrides": {
    "expo-font": "~12.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.5.4"
  }
}
