{
  "url": "https://take-the-shot-api.vercel.app",
  "timeoutMs": 10000,
  "checks": [
    { "name": "health", "path": "/api/health", "status": 200, "json": { "ok": true } },
    { "name": "login page", "path": "/login", "status": 200, "contains": "Welcome back" },
    { "name": "home page", "path": "/", "status": 200, "contains": "Take the shot" },
    { "name": "privacy page", "path": "/privacy", "status": 200, "contains": "Privacy policy" },
    { "name": "robots.txt", "path": "/robots.txt", "status": 200, "contains": "Sitemap" },
    { "name": "sitemap.xml", "path": "/sitemap.xml", "status": 200, "contains": "<urlset" },
    { "name": "custom 404", "path": "/this-page-does-not-exist", "status": 404, "contains": "This page went missing" },
    { "name": "auth wall", "path": "/api/collections", "status": 401 }
  ]
}
